# Server deployment configuration (local development uses apps/api/.env).
# Existing PostgreSQL database. URL-encode special characters in credentials.
# For PostgreSQL on Ubuntu itself, use host.docker.internal instead of localhost.
DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/toggle-ctrl
WEB_APP_URL=https://toggle.example.com
# Ports are selected automatically by the helper starting at 5001.
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=true

# Configure a reachable SMTP server for invitations/password emails.
# localhost inside a container is that container, not the Ubuntu host.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
