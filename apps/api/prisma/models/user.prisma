model User {
  id              String       @id @default(uuid())
  email           String       @unique
  name            String
  passwordHash    String?
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  memberships     Membership[]
  sessions        Session[]
  tokens          AccountToken[]
  invitationsSent Invitation[] @relation("InvitationSender")
}
