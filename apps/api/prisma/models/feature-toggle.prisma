model FeatureToggle {
  id             String                    @id @default(uuid())
  organizationId String
  name           String
  description    String?
  enabled        Boolean                   @default(false)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @default(now()) @updatedAt
  createdById    String
  updatedById    String
  archivedAt     DateTime?
  archivedById   String?
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User                      @relation("FeatureToggleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User                      @relation("FeatureToggleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  archivedBy     User?                     @relation("FeatureToggleArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  auditEvents    FeatureToggleAuditEvent[]

  @@index([archivedAt])
  @@index([organizationId, archivedAt, updatedAt])
}
