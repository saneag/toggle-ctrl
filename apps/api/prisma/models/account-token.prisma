model AccountToken {
  id           String   @id @default(uuid())
  tokenHash    String   @unique
  purpose      String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
